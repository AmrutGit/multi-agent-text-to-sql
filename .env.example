# Copy to .env and fill in. .env is gitignored. Keys are read from the environment too.

# Default model served by the /query API (benchmarks use evals/models.yaml instead)
GEMINI_API_KEY=            # free key: https://aistudio.google.com/app/apikey
# LLM_PROVIDER=gemini      # gemini | anthropic | openai_compat
# LLM_MODEL=gemini-3.8-flash
# LLM_BASE_URL=            # openai_compat only, e.g. http://localhost:8001/v1
# LLM_API_KEY_ENV=GEMINI_API_KEY   # NAME of the env var holding the key

# Needed only to benchmark Anthropic models
ANTHROPIC_API_KEY=
